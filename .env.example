# Copy this file to .env.local for local development, or .env.prod for a production deployment.
# Do not commit either real environment file.
NODE_ENV=development
PORT=3000
MONGO_URI=mongodb://localhost:27017/dogdex

# Generate distinct secrets with at least 32 characters.
JWT_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Development accepts all origins temporarily. Production requires this allowlist.
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=false
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3000

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
AI_SERVICE_URL=http://localhost:8000

# Optional integrations
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GEMINI_API_KEY=
BREVO_API_KEY=
EMAIL_FROM=
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_HOSTNAME=test-payment.momo.vn
